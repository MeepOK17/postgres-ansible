[Unit]
Description=PostgreSQL {{ __pg_version }}
After=network.target

[Service]
Type=notify
User=postgres
Group=postgres
ExecStart={{ __pg_bin }}/postgres -D {{ postgres__data_dir }}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=infinity

[Install]
WantedBy=multi-user.target
